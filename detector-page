<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Fake News Detector</title>
  <link rel="stylesheet" href="css/style.css" />
</head>
<body class="landing">

  <div class="overlay"></div>

  <main class="hero">
    <h1>Fake News Detector</h1>
    <p>Paste a news article or headline below</p>

    <textarea id="newsText" placeholder="Enter news text here..."
      style="width:100%;max-width:700px;height:180px;padding:15px;border-radius:10px;">
    </textarea>

    <br><br>
    <button class="btn" onclick="checkNews()">Check News</button>

    <h3 id="result" style="margin-top:30px;"></h3>

    <a href="index.html" style="display:block;margin-top:40px;color:#9ae6b4;">
      ← Back to Home
    </a>
  </main>

  <script src="js/detector.js"></script>
</body>
</html>
